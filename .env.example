BOT_TOKEN=<TOKEN_HERE>

AKASHIC_SERVER_ID=<AKASHIC_SERVER_ID_HERE>
AKASHIC_VERIF_CHANNEL_ID=<AKASHIC_VERIF_CHANNEL_ID_HERE>
AKASHIC_WELCOME_CHANNEL_ID=<AKASHIC_WELCOME_CHANNEL_ID_HERE>
AKASHIC_RULE_CHANNEL_ID=<AKASHIC_RULE_CHANNEL_ID_HERE>
AKASHIC_VERIFIED_ROLE_ID=<AKASHIC_VERIFIED_ROLE_ID_HERE>
AKASHIC_HONEYPOT_CHANNEL_ID=<AKASHIC_HONEYPOT_CHANNEL_ID_HERE>

CHISA_MOD_CHANNEL_ID=<CHISA_MOD_CHANNEL_ID_HERE>
CHISA_LOG_CHANNEL_ID=<CHISA_LOG_CHANNEL_ID_HERE>

REDIS_URL=redis://localhost:6379

# --- Currency ---
WISE_TOKEN=<WISE_TOKEN_HERE>
CURRENCY_API_TOKEN=<CURRENCY_API_TOKEN_HERE>
# Currency provider to use: "wise" or "currency_api"
CURRENCY_PROVIDER=wise

# Interactive Quiz WebSocket server port (default: 8080)
QUIZ_WS_PORT=8080

# --- Music ---
# SOCKS5 proxy for outbound yt-dlp traffic. Needed where YouTube/Discord media
# hosts are blocked or IPv6 is unreachable. Empty = no proxy (direct).
# Format: socks5://user:pass@host:port  (auth part is optional)
PROXY_URL=

# Path to the yt-dlp executable. Empty = bundled ./bin/yt-dlp, then yt-dlp on PATH.
YTDLP_PATH=./bin/yt-dlp